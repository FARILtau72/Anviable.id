# Environment configuration for Anviable Web Application (Next.js)

# Database Connection (TiDB Cloud Serverless / MySQL 8.0)
# Format: mysql://<username>:<password>@<host>:<port>/<database>
DATABASE_URL="mysql://your_tidb_user:your_tidb_password@gateway03.us-west-2.prod.aws.tidbcloud.com:4000/your_database_name"

# Admin Dashboard Authentication Password
ADMIN_PASSWORD="your-secure-admin-password"

# Public Application URL (set to your domain on VPS, e.g. https://anviable.id)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
